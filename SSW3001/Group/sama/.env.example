# SamaRasa API Configuration
# Copy this file to .env and fill in your API keys

# ==========================================
# OpenAI API (for intelligent chat)
# ==========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Twilio API (for SMS/call notifications)
# ==========================================
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Emergency contact phone numbers (comma-separated)
EMERGENCY_CONTACTS=+60123456789,+60198765432

# ==========================================
# SendGrid API (for email notifications)
# ==========================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=samarasa@yourdomain.com
# Emergency contact emails (comma-separated)
EMERGENCY_EMAILS=caregiver1@example.com,caregiver2@example.com

# ==========================================
# Google Cloud APIs (optional)
# ==========================================
# For better translation and speech services
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here

# ==========================================
# Application Settings
# ==========================================
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# ==========================================
# Feature Toggles
# ==========================================
# Enable/disable specific API integrations
ENABLE_OPENAI=true
ENABLE_TWILIO=true
ENABLE_SENDGRID=true
ENABLE_GOOGLE_TRANSLATE=false
ENABLE_VOICE_SYNTHESIS=true
ENABLE_GEOLOCATION=true
