# SamaRasa API Configuration
# DEMO MODE - Replace with real API keys for production

# OpenAI API
OPENAI_API_KEY=demo_mode
OPENAI_MODEL=gpt-4o-mini

# Twilio API
TWILIO_ACCOUNT_SID=demo_mode
TWILIO_AUTH_TOKEN=demo_mode
TWILIO_PHONE_NUMBER=+1234567890
EMERGENCY_CONTACTS=+60123456789

# SendGrid API
SENDGRID_API_KEY=demo_mode
SENDGRID_FROM_EMAIL=samarasa@demo.com
EMERGENCY_EMAILS=caregiver@demo.com

# Google Cloud APIs
GOOGLE_CLOUD_API_KEY=demo_mode
GOOGLE_CLOUD_PROJECT_ID=demo_mode

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=demo_secret_key_change_in_production

# Feature Toggles (set to false if no API keys)
ENABLE_OPENAI=false
ENABLE_TWILIO=false
ENABLE_SENDGRID=false
ENABLE_GOOGLE_TRANSLATE=false
ENABLE_VOICE_SYNTHESIS=true
ENABLE_GEOLOCATION=true
