# SMAMRASA Environment Configuration
# Copy this file to .env and fill in your values

# ==================== DATABASE CONFIGURATION ====================
DB_PASSWORD=smamrasa_password_2024
REDIS_PASSWORD=redis_password_2024

# ==================== JWT & SECURITY ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==================== TWILIO (SMS) ====================
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# ==================== SENDGRID (EMAIL) ====================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@smamrasa.com

# ==================== FIREBASE (PUSH NOTIFICATIONS) ====================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ==================== AWS S3 (FILE STORAGE) ====================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=smamrasa-files

# ==================== STRIPE (PAYMENTS) ====================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== VIDEO CONFERENCE ====================
# For production, you'll need TURN/STUN servers
# You can use Twilio TURN or self-hosted Coturn
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_password

# ==================== ML MODEL CONFIGURATION ====================
# For Triage Service
MODEL_PATH=/app/ml-models/triage_model.pkl
MODEL_THRESHOLD=0.7

# ==================== MONITORING ====================
GRAFANA_PASSWORD=admin123
PROMETHEUS_RETENTION=15d

# ==================== SECURITY HEADERS ====================
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== FEATURE FLAGS ====================
ENABLE_EMERGENCY_TRIAGE=true
ENABLE_IOT_INTEGRATION=true
ENABLE_VIDEO_RECORDING=false
ENABLE_ANALYTICS=true

# ==================== API CONFIGURATION ====================
API_GATEWAY_URL=http://localhost:8000
SERVICE_TIMEOUT=30000
MAX_PAYLOAD_SIZE=50mb

# ==================== BACKUP CONFIGURATION ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ==================== HIPAA COMPLIANCE ====================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_YEARS=7
ENCRYPTION_ALGORITHM=AES-256-GCM

# ==================== DEVELOPMENT ====================
NODE_ENV=development
DEBUG=true

# ==================== PRODUCTION OVERRIDES ====================
# In production, override these with secure values:
# DB_PASSWORD=complex_secure_password
# JWT_SECRET=very_long_random_string
# All API keys from respective providers
